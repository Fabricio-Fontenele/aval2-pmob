# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (PostgreSQL / Supabase connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/lost_and_found?sslmode=disable

# Authentication Session Settings
SESSION_TTL_HOURS=24

# Attempt limits: registration per address/hour; login per email/address/15 minutes
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_ADDRESS_LIMIT=20
AUTH_MAX_CONCURRENT=2

# Empty by default. Only exact, trusted proxy IPs may supply X-Forwarded-For.
TRUSTED_PROXY_IPS=
